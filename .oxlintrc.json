{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "ignorePatterns": [".claude/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": ["**/design-system/components/**"],
            "message": "Import design-system components from 'src/design-system' (its index.js), not component internals."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/index.js", "**/design-system/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "**/design-system/components/recipes/DietaryChips.jsx",
        "**/design-system/components/recipes/TimePill.jsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
